#!/system/bin/sh
# E404 Kernel CLI System Fetch Tool for POCO X3 Pro (vayu/bhima)

# ANSI Colors
Y=$(printf '\033[1;33m')
C=$(printf '\033[1;36m')
G=$(printf '\033[1;32m')
W=$(printf '\033[1;37m')
N=$(printf '\033[0m')

read_val() {
    [ -r "$1" ] && cat "$1" 2>/dev/null
}

# Device Info
MODEL=$(getprop ro.product.marketname 2>/dev/null)
[ -z "$MODEL" ] && MODEL=$(getprop ro.product.model 2>/dev/null)
[ -z "$MODEL" ] && MODEL="POCO X3 Pro"
CODENAME=$(getprop ro.product.device 2>/dev/null)
[ -z "$CODENAME" ] && CODENAME="vayu"
ANDROID_VER=$(getprop ro.build.version.release 2>/dev/null)
KERNEL_VER=$(uname -r)

# CPU Usage % (two /proc/stat samples, 32-bit mksh overflow-safe)
CPU_PCT="N/A"
if [ -r /proc/stat ]; then
    read -r _ u1 n1 s1 i1 io1 irq1 sirq1 _ < /proc/stat
    sleep 0.2 2>/dev/null || usleep 200000 2>/dev/null || sleep 1
    read -r _ u2 n2 s2 i2 io2 irq2 sirq2 _ < /proc/stat
    du=$((u2 - u1))
    dn=$((n2 - n1))
    ds=$((s2 - s1))
    di_idle=$((i2 - i1))
    dio=$((io2 - io1))
    dirq=$((irq2 - irq1))
    dsirq=$((sirq2 - sirq1))
    dt=$((du + dn + ds + di_idle + dio + dirq + dsirq))
    di=$((di_idle + dio))
    if [ "$dt" -gt 0 ] 2>/dev/null; then
        pct10=$((((dt - di) * 1000) / dt))
        CPU_PCT="$((pct10 / 10)).$((pct10 % 10))%"
    else
        CPU_PCT="0.0%"
    fi
fi

# CPU Frequencies (Little / Big / Prime)
F0=$(read_val /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq)
F4=$(read_val /sys/devices/system/cpu/cpufreq/policy4/scaling_cur_freq)
F7=$(read_val /sys/devices/system/cpu/cpufreq/policy7/scaling_cur_freq)
[ -n "$F0" ] && F0=$((F0 / 1000)) || F0="?"
[ -n "$F4" ] && F4=$((F4 / 1000)) || F4="?"
[ -n "$F7" ] && F7=$((F7 / 1000)) || F7="?"

# GPU Info (Adreno 640)
GPU_CLK=$(read_val /sys/class/kgsl/kgsl-3d0/gpuclk)
[ -n "$GPU_CLK" ] && GPU_MHZ=$((GPU_CLK / 1000000)) || GPU_MHZ="?"
GPU_BUSY=$(read_val /sys/class/kgsl/kgsl-3d0/gpu_busy_percentage)
GPU_BUSY=$(echo "$GPU_BUSY" | tr -d ' %')
[ -n "$GPU_BUSY" ] && GPU_STR="Adreno 640 @ ${GPU_MHZ} MHz (${GPU_BUSY}%)" || GPU_STR="Adreno 640 @ ${GPU_MHZ} MHz"

# RAM & ZRAM Info (POSIX sh, mksh 32-bit int safe)
RAM_STR="N/A"
if [ -r /proc/meminfo ]; then
    MEM_TOT=0
    MEM_AVAIL=""
    MEM_FREE=0
    while read -r k v _; do
        case "$k" in
            MemTotal:) MEM_TOT=$v ;;
            MemAvailable:) MEM_AVAIL=$v ;;
            MemFree:) MEM_FREE=$v ;;
        esac
        [ -n "$MEM_AVAIL" ] && [ "$MEM_TOT" -gt 0 ] 2>/dev/null && break
    done < /proc/meminfo
    [ -z "$MEM_AVAIL" ] && MEM_AVAIL=$MEM_FREE
    if [ "$MEM_TOT" -gt 0 ] 2>/dev/null; then
        USED_MB=$(((MEM_TOT - MEM_AVAIL) / 1024))
        TOT_MB=$((MEM_TOT / 1024))
        if [ "$TOT_MB" -gt 0 ]; then
            RAM_PCT10=$(((USED_MB * 1000) / TOT_MB))
            RAM_STR="${USED_MB} / ${TOT_MB} MB ($((RAM_PCT10 / 10)).$((RAM_PCT10 % 10))%)"
        fi
    fi
fi

ZRAM_STR="N/A"
if [ -r /sys/block/zram0/mm_stat ]; then
    read -r z_orig z_compr _ < /sys/block/zram0/mm_stat
    if [ -n "$z_orig" ] && [ -n "$z_compr" ]; then
        if [ ${#z_orig} -gt 3 ]; then z_orig_mb=$((${z_orig%???} / 1048)); else z_orig_mb=0; fi
        if [ ${#z_compr} -gt 3 ]; then z_compr_mb=$((${z_compr%???} / 1048)); else z_compr_mb=0; fi
        ZRAM_STR="${z_orig_mb} MB used (${z_compr_mb} MB compr)"
    fi
fi

# Network: IP & MAC
extract_ip() {
    while read -r line; do
        case "$line" in
            *"inet 127."*) ;;
            *"inet "*)
                set -- $line
                while [ $# -gt 0 ]; do
                    if [ "$1" = "inet" ] && [ -n "$2" ]; then
                        echo "${2%%/*}"
                        return
                    fi
                    shift
                done
                ;;
        esac
    done
}

IP_ADDR=$(ip -4 addr show wlan0 2>/dev/null | extract_ip)
[ -z "$IP_ADDR" ] && IP_ADDR=$(ip -4 addr show 2>/dev/null | extract_ip)
[ -z "$IP_ADDR" ] && IP_ADDR="Disconnected"

MAC_ADDR=$(read_val /sys/class/net/wlan0/address)
if [ -z "$MAC_ADDR" ]; then
    MAC_ADDR=$(ip link show wlan0 2>/dev/null | {
        while read -r line; do
            case "$line" in
                *"link/ether "*)
                    set -- $line
                    while [ $# -gt 0 ]; do
                        if [ "$1" = "link/ether" ] && [ -n "$2" ]; then
                            echo "$2"
                            break
                        fi
                        shift
                    done
                    break
                    ;;
            esac
        done
    })
fi
[ -z "$MAC_ADDR" ] && MAC_ADDR="Hidden (No Root)"

# Battery Health Info
BAT_CAP=$(read_val /sys/class/power_supply/battery/capacity)
BAT_HEALTH=$(read_val /sys/class/power_supply/battery/health)
BAT_STATUS=$(read_val /sys/class/power_supply/battery/status)
BAT_TEMP_RAW=$(read_val /sys/class/power_supply/battery/temp)
BAT_VOLT_RAW=$(read_val /sys/class/power_supply/battery/voltage_now)
BAT_CURR_RAW=$(read_val /sys/class/power_supply/battery/current_now)
BAT_FULL=$(read_val /sys/class/power_supply/battery/charge_full)
BAT_DESIGN=$(read_val /sys/class/power_supply/battery/charge_full_design)

if [ -n "$BAT_TEMP_RAW" ]; then
    BAT_T_ABS=${BAT_TEMP_RAW#-}
    BAT_TEMP="$((BAT_TEMP_RAW / 10)).$((BAT_T_ABS % 10))°C"
else
    BAT_TEMP="?"
fi

if [ -n "$BAT_VOLT_RAW" ]; then
    BAT_MV=$((BAT_VOLT_RAW / 10000))
    BAT_VR=$((BAT_MV % 100))
    [ "$BAT_VR" -lt 10 ] && BAT_VR="0$BAT_VR"
    BAT_VOLT="$((BAT_MV / 100)).${BAT_VR}V"
else
    BAT_VOLT="?"
fi

[ -n "$BAT_CURR_RAW" ] && BAT_CURR=$((BAT_CURR_RAW / 1000)) || BAT_CURR="?"

BAT_LIFE=""
if [ -n "$BAT_FULL" ] && [ -n "$BAT_DESIGN" ] && [ "$BAT_DESIGN" -gt 0 ] 2>/dev/null; then
    BF_MAH=$((BAT_FULL / 1000))
    BD_MAH=$((BAT_DESIGN / 1000))
    if [ "$BD_MAH" -gt 0 ]; then
        BAT_PCT=$(((BF_MAH * 100) / BD_MAH))
        BAT_LIFE=" | Cap: ${BF_MAH}/${BD_MAH} mAh (${BAT_PCT}%)"
    fi
fi

# Kernel Features Status
TCP_CC=$(read_val /proc/sys/net/ipv4/tcp_congestion_control)
[ -z "$TCP_CC" ] && TCP_CC="N/A"
WL_BLK=$(read_val /sys/module/wakeup/parameters/enable_wakelock_blocker)
if [ "$WL_BLK" = "Y" ] || [ "$WL_BLK" = "1" ]; then
    WL_STR="Active"
else
    WL_STR="Off"
fi
MGLRU=$(read_val /sys/kernel/mm/lru_gen/enabled)
[ -n "$MGLRU" ] && MGLRU_STR="Enabled ($MGLRU)" || MGLRU_STR="N/A"

printf '%s\n' \
    "" \
    "${Y}  ____   ___   ____  ___  ${N}  ${C}E404 CYBERNETIC FETCH${N}" \
    "${Y}"' |  _ \ / _ \ / ___|/ _ \ '"${N}  ${W}Device  :${N} ${G}${MODEL} (${CODENAME})${N}" \
    "${Y}"' | |_) | | | | |   | | | |'"${N}  ${W}Android :${N} ${ANDROID_VER:-N/A} | ${W}Kernel:${N} ${KERNEL_VER}" \
    "${Y}"' |  __/| |_| | |___| |_| |'"${N}  ${W}CPU     :${N} ${CPU_PCT} (${F0}/${F4}/${F7} MHz)" \
    "${Y}"' |_|    \___/ \____|\___/ '"${N}  ${W}GPU     :${N} ${GPU_STR}" \
    "${C}  >> E404 KERNEL VAYU <<  ${N}  ${W}RAM     :${N} ${RAM_STR}" \
    "                            ${W}ZRAM    :${N} ${ZRAM_STR}" \
    "                            ${W}IP Addr :${N} ${IP_ADDR}" \
    "                            ${W}MAC Addr:${N} ${MAC_ADDR}" \
    "                            ${W}Battery :${N} ${BAT_CAP:-?}% (${BAT_STATUS:-?}, ${BAT_HEALTH:-?}) ${BAT_TEMP} | ${BAT_VOLT} | ${BAT_CURR} mA${BAT_LIFE}" \
    "                            ${W}Tuning  :${N} TCP=${TCP_CC} | DeepSleep=${WL_STR} | MGLRU=${MGLRU_STR}" \
    ""
